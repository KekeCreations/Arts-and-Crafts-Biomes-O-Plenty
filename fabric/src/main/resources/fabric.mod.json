{
    "schemaVersion": 1,
    "id": "arts_and_crafts_bop",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.kekecreations.arts_and_crafts_biomes_o_plenty.FabricArtsAndCraftsBiomesOPlenty"
        ],
        "client": [
            "com.kekecreations.arts_and_crafts_biomes_o_plenty.client.ACBOPFabricClient"
        ],
        "fabric-datagen": [
            "com.kekecreations.arts_and_crafts_biomes_o_plenty.datagen.ACBOPDataGenerator"
        ]
    },
    "depends": {
        "fabricloader": ">=0.14",
        "fabric": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=17",
        "arts_and_crafts": ">=1.5.4"
    },
    "suggests": {
        "another-mod": "*"
    }
}
  